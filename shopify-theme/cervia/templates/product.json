    "garantia": {
      "type": "cervia-garantia",
      "settings": {
        "dias": 30,
        "texto": "<p>Duerme con ella, nota la diferencia y decide con calma. Si en [[dias]] noches no es para ti, escríbenos desde la página de contacto y te ayudamos con la devolución.</p>"
      }
