    "faq": {
      "type": "cervia-faq",
      "settings": {
        "sub": "¿Te queda alguna duda? Escríbenos desde la página de contacto."
      },
      "blocks": {
        "pregunta_0": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto dura la batería?",
            "respuesta": "<p>Unos 70 minutos con una carga completa. Se carga a 5 V, con cualquier cargador USB.</p>"
          }
        },
        "pregunta_1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto tiempo debo usarlo?",
            "respuesta": "<p>Sesiones de unos 10 minutos. Puedes repetir a lo largo del día si lo necesitas.</p>"
          }
        },
        "pregunta_2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Se puede usar sin calor?",
            "respuesta": "<p>Sí. El calor es opcional y tiene 2 niveles; puedes usar solo el masaje.</p>"
          }
        },
        "pregunta_3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Lo puedo usar en otras zonas?",
            "respuesta": "<p>Está pensado para cuello y hombros, pero también puedes usarlo en la zona lumbar o en las piernas.</p>"
          }
        },
        "pregunta_4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Quién no debería usarlo?",
            "respuesta": "<p>Si estás embarazada, llevas marcapasos o tienes una lesión, consulta antes con tu médico.</p>"
          }
        },
        "pregunta_5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuándo me llega?",
            "respuesta": "<p>El envío es gratis desde España. Lo recibes en 7–12 días laborables.</p>"
          }
        },
        "pregunta_6": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Y si no me convence?",
            "respuesta": "<p>Tienes 30 días para probarlo. Escríbenos desde la página de contacto y te explicamos cómo devolverlo.</p>"
          }
        },
        "pregunta_7": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Es seguro pagar aquí?",
            "respuesta": "<p>Sí. El pago se procesa con cifrado y puedes usar tarjeta, PayPal, Apple Pay, Google Pay o Bizum.</p>"
          }
        }
      },
