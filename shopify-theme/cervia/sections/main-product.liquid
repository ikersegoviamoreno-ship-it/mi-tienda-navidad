<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px !important;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px !important;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px !important;
        padding-bottom: {{ section.settings.padding_bottom }}px !important;
      }
    }
  {%- endstyle -%}

  {%- style -%}
    #MainProduct-{{ section.id }} {
      --marca-primario: {{ section.settings.marca_color_primario }};
      --marca-primario-texto: {{ section.settings.marca_color_primario_texto }};
      --marca-acento: {{ section.settings.marca_color_acento }};
      --marca-texto: {{ section.settings.marca_color_texto }};
      --marca-borde: {{ section.settings.marca_color_borde }};
      --marca-fondo: {{ section.settings.marca_color_fondo }};
      --marca-radius: {{ section.settings.marca_radius }}px;
      --marca-radius-boton: {{ section.settings.marca_radius_boton }}px;
      --marca-gap: {{ section.settings.marca_gap_movil }}px;
      --marca-ease: cubic-bezier(.22,.8,.35,1);
      background: var(--marca-fondo) !important;
      color: var(--marca-texto) !important;
      font-family: var(--font-body, var(--font-body-family)) !important;
      padding-top: {{ section.settings.marca_padding_superior_movil }}px !important;
      padding-bottom: {{ section.settings.marca_padding_inferior_movil }}px !important;
    }
    @media screen and (min-width: 750px) {
      #MainProduct-{{ section.id }} { --marca-gap: {{ section.settings.marca_gap }}px; padding-top: {{ section.settings.marca_padding_superior }}px !important; padding-bottom: {{ section.settings.marca_padding_inferior }}px !important; }
      #MainProduct-{{ section.id }} .page-width { max-width: {{ section.settings.marca_ancho_maximo }}px !important; padding-inline: {{ section.settings.marca_padding_lateral }}px !important; margin-inline: auto !important; }
      #MainProduct-{{ section.id }} .product { --grid-desktop-horizontal-spacing: {{ section.settings.marca_gap_columnas }}px; }
      #MainProduct-{{ section.id }} .thumbnail-list { display: flex !important; overflow-x: auto !important; scroll-snap-type: x mandatory !important; gap: {{ section.settings.marca_miniaturas_gap }}px !important; scrollbar-width: none !important; }
      #MainProduct-{{ section.id }} .thumbnail-list::-webkit-scrollbar { display: none !important; }
      #MainProduct-{{ section.id }} .thumbnail-list__item { flex: 0 0 calc((100% - {{ section.settings.marca_miniaturas_escritorio | minus: 1 }} * {{ section.settings.marca_miniaturas_gap }}px) / {{ section.settings.marca_miniaturas_escritorio }}) !important; max-width: none !important; scroll-snap-align: start !important; }
      #MainProduct-{{ section.id }} .thumbnail-slider .slider-button { display: none !important; }
      #MainProduct-{{ section.id }} .cervia-oculto-escritorio { display: none !important; }
    }
    @media screen and (max-width: 749px) {
      #MainProduct-{{ section.id }} .product__media-wrapper { width: 100vw !important; margin-left: calc(50% - 50vw) !important; padding: 0 !important; }
      #MainProduct-{{ section.id }} .product__media-list { display: flex !important; overflow-x: auto !important; scroll-snap-type: x mandatory !important; scroll-behavior: smooth !important; gap: 0 !important; margin: 0 !important; padding: 0 !important; scrollbar-width: none !important; }
      #MainProduct-{{ section.id }} .product__media-list::-webkit-scrollbar { display: none !important; }
      #MainProduct-{{ section.id }} .product__media-item { flex: 0 0 100% !important; width: 100% !important; scroll-snap-align: start !important; padding: 0 !important; }
      #MainProduct-{{ section.id }} .product-media-container { border-radius: 0 !important; aspect-ratio: {{ section.settings.marca_galeria_ratio }} !important; }
      #MainProduct-{{ section.id }} .product-media-container img { width: 100% !important; height: 100% !important; object-fit: cover !important; }
      #MainProduct-{{ section.id }} .slider-buttons, #MainProduct-{{ section.id }} .slider-counter { display: none !important; }
      #MainProduct-{{ section.id }} .thumbnail-slider { display: block !important; margin-top: 8px !important; overflow: hidden !important; }
      #MainProduct-{{ section.id }} .thumbnail-slider .slider-button { display: none !important; }
      #MainProduct-{{ section.id }} .thumbnail-list { display: flex !important; width: 100% !important; box-sizing: border-box !important; overflow-x: auto !important; scroll-snap-type: x mandatory !important; scroll-padding-inline: 16px !important; scroll-behavior: smooth !important; gap: {{ section.settings.marca_miniaturas_gap }}px !important; padding: 0 16px !important; margin: 0 !important; scrollbar-width: none !important; }
      #MainProduct-{{ section.id }} .thumbnail-list::-webkit-scrollbar { display: none !important; }
      #MainProduct-{{ section.id }} .thumbnail-list__item { flex: 0 0 calc((100vw - 32px - {{ section.settings.marca_miniaturas_movil | minus: 1 }} * {{ section.settings.marca_miniaturas_gap }}px) / {{ section.settings.marca_miniaturas_movil }}) !important; width: auto !important; max-width: none !important; margin: 0 !important; scroll-snap-align: start !important; }
      #MainProduct-{{ section.id }} .thumbnail { width: 100% !important; margin: 0 !important; aspect-ratio: 1 !important; border: 2px solid transparent !important; }
      #MainProduct-{{ section.id }} .product__info-wrapper { padding-top: 20px !important; }
      #MainProduct-{{ section.id }} .cervia-oculto-movil { display: none !important; }
    }
    #MainProduct-{{ section.id }} .product__media-icon { display: none !important; }
    #MainProduct-{{ section.id }} .product__media-toggle { display: none !important; pointer-events: none !important; }
    #MainProduct-{{ section.id }} .product__modal-opener { cursor: default !important; }
    #MainProduct-{{ section.id }} .thumbnail-list { scroll-behavior: smooth !important; }
    #MainProduct-{{ section.id }} .thumbnail { border-radius: {{ section.settings.marca_miniaturas_radius }}px !important; overflow: hidden !important; border: 2px solid transparent !important; }
    #MainProduct-{{ section.id }} .thumbnail[aria-current] { border-color: var(--marca-acento) !important; }
    #MainProduct-{{ section.id }} .product__view-details { display: none !important; }
    #MainProduct-{{ section.id }} .product__info-container > * + * { margin-top: var(--marca-gap) !important; }
    #MainProduct-{{ section.id }} .product-form__submit,
    #MainProduct-{{ section.id }} .shopify-payment-button__button--unbranded { min-height: 52px !important; border-radius: var(--marca-radius-boton) !important; font-weight: 600 !important; transition: transform .15s var(--marca-ease), opacity .15s var(--marca-ease) !important; }
    #MainProduct-{{ section.id }} .product-form__submit { background: var(--marca-primario) !important; color: var(--marca-primario-texto) !important; border: 0 !important; }
    #MainProduct-{{ section.id }} .product-form__submit::after, #MainProduct-{{ section.id }} .product-form__submit::before { box-shadow: none !important; }
    #MainProduct-{{ section.id }} .product-form__submit:not([disabled]):active { transform: translateY(1px) !important; }
    #MainProduct-{{ section.id }} .product-form__submit[disabled] { opacity: .5 !important; }
    #MainProduct-{{ section.id }} .product-form__input--pill label { border-radius: var(--marca-radius-boton) !important; border: 1px solid var(--marca-borde) !important; box-shadow: none !important; color: var(--marca-texto) !important; background: transparent !important; }
    #MainProduct-{{ section.id }} .product-form__input--pill input[type="radio"]:checked + label { background: var(--marca-primario) !important; color: var(--marca-primario-texto) !important; border-color: var(--marca-primario) !important; }
    #MainProduct-{{ section.id }} .product-form__input--dropdown .select__select { border-radius: var(--marca-radius-boton) !important; }
    #MainProduct-{{ section.id }} .swatch-input__input:checked + .swatch-input__label { outline: 2px solid var(--marca-acento) !important; outline-offset: 2px !important; }
    #MainProduct-{{ section.id }} .product-media-container { overflow: hidden !important; }
    #MainProduct-{{ section.id }} .cervia-i { width: 24px !important; height: 24px !important; fill: none !important; stroke: currentColor !important; stroke-width: 1.75 !important; stroke-linecap: round !important; stroke-linejoin: round !important; flex-shrink: 0 !important; display: block !important; }
    #MainProduct-{{ section.id }} .cervia-b { text-align: var(--alin) !important; color: var(--marca-texto) !important; }
    #MainProduct-{{ section.id }} .cervia-b :where(p) { margin: 0 !important; }
    #MainProduct-{{ section.id }} .cervia-b :focus-visible { outline: 2px solid var(--marca-acento) !important; outline-offset: 2px !important; }
    #MainProduct-{{ section.id }} .cervia-aviso { margin-top: 8px !important; padding: 8px 12px !important; border-radius: 8px !important; background: color-mix(in srgb, var(--marca-acento) 14%, transparent) !important; font-size: 13px !important; }

    #MainProduct-{{ section.id }} .cervia-titulo__eyebrow { font-size: var(--eyebrow) !important; font-weight: 600 !important; letter-spacing: .06em !important; color: var(--c-eyebrow) !important; margin-bottom: 8px !important; }
    #MainProduct-{{ section.id }} .cervia-titulo__eyebrow.is-mayus { text-transform: uppercase !important; }
    #MainProduct-{{ section.id }} .cervia-titulo__fila { display: flex !important; align-items: baseline !important; justify-content: var(--alin-flex) !important; gap: 16px !important; }
    #MainProduct-{{ section.id }} .cervia-titulo__fila.is-precio-derecha { justify-content: space-between !important; }
    #MainProduct-{{ section.id }} .cervia-titulo__h { margin: 0 !important; font-family: var(--font-heading, var(--font-heading-family)) !important; font-size: var(--titulo) !important; font-weight: var(--peso-titulo) !important; line-height: 1.12 !important; letter-spacing: -0.015em !important; color: var(--c-titulo) !important; overflow-wrap: anywhere !important; min-width: 0 !important; }
    #MainProduct-{{ section.id }} .cervia-titulo__sub { margin-top: 8px !important; font-size: var(--sub) !important; line-height: 1.45 !important; color: var(--c-sub) !important; }
    #MainProduct-{{ section.id }} .cervia-titulo__precio.is-debajo { margin-top: 10px !important; }
    #MainProduct-{{ section.id }} .cervia-titulo__precio .cervia-precio__precio { font-size: calc(var(--titulo) * .75) !important; }
    #MainProduct-{{ section.id }} .cervia-valoracion { display: inline-flex !important; align-items: center !important; gap: 8px !important; margin-top: 12px !important; text-decoration: none !important; color: var(--c-titulo) !important; font-size: 14px !important; }
    #MainProduct-{{ section.id }} .cervia-valoracion__nota { font-weight: 600 !important; }
    #MainProduct-{{ section.id }} .cervia-valoracion__num { color: var(--c-sub) !important; text-decoration: underline !important; text-underline-offset: 3px !important; }
    #MainProduct-{{ section.id }} .cervia-estrellas { position: relative !important; display: inline-block !important; line-height: 0 !important; }
    #MainProduct-{{ section.id }} .cervia-estrellas__fondo, #MainProduct-{{ section.id }} .cervia-estrellas__llenas { display: inline-flex !important; gap: 2px !important; white-space: nowrap !important; }
    #MainProduct-{{ section.id }} .cervia-estrellas__fondo { color: var(--c-estrella-vacia) !important; }
    #MainProduct-{{ section.id }} .cervia-estrellas__llenas { position: absolute !important; inset: 0 auto 0 0 !important; overflow: hidden !important; color: var(--c-estrella) !important; }
    #MainProduct-{{ section.id }} .cervia-estrellas svg { width: var(--estrellas) !important; height: var(--estrellas) !important; fill: currentColor !important; flex-shrink: 0 !important; }

    #MainProduct-{{ section.id }} .cervia-precio__linea { display: flex !important; align-items: center !important; justify-content: var(--alin-flex) !important; gap: 10px !important; flex-wrap: wrap !important; }
    #MainProduct-{{ section.id }} .cervia-precio__precio { font-family: var(--font-heading, var(--font-heading-family)) !important; font-size: var(--precio, 28px) !important; font-weight: 700 !important; line-height: 1 !important; color: var(--c-precio, var(--marca-texto)) !important; letter-spacing: -0.01em !important; }
    #MainProduct-{{ section.id }} .cervia-precio__anterior { font-size: 16px !important; color: var(--c-tachado, var(--marca-texto)) !important; opacity: .8 !important; }
    #MainProduct-{{ section.id }} .cervia-precio__ahorro { font-size: 13px !important; font-weight: 600 !important; padding: 5px 10px !important; border-radius: 999px !important; background: var(--c-chip) !important; color: var(--c-chip-texto) !important; line-height: 1 !important; }
    #MainProduct-{{ section.id }} .cervia-precio__nota { margin-top: 6px !important; font-size: var(--nota) !important; color: var(--c-nota) !important; }
    #MainProduct-{{ section.id }} [hidden] { display: none !important; }

    #MainProduct-{{ section.id }} .cervia-separador__fila { display: flex !important; align-items: center !important; gap: 12px !important; }
    #MainProduct-{{ section.id }} .cervia-separador__fila.is-corto { width: 30% !important; margin-inline: auto !important; }
    #MainProduct-{{ section.id }} .cervia-separador__linea { flex: 1 !important; height: 0 !important; border-top: var(--grosor) solid var(--c-linea) !important; }
    #MainProduct-{{ section.id }} .is-punteada .cervia-separador__linea { border-top-style: dashed !important; }
    #MainProduct-{{ section.id }} .is-degradado .cervia-separador__linea { border: 0 !important; height: var(--grosor) !important; background: linear-gradient(90deg, transparent, var(--c-linea), transparent) !important; }
    #MainProduct-{{ section.id }} .cervia-separador__texto { font-size: var(--sep-texto) !important; color: var(--c-sep-texto) !important; font-weight: 600 !important; white-space: nowrap !important; }

    #MainProduct-{{ section.id }} .cervia-checks__lista { list-style: none !important; margin: 0 !important; padding: 0 !important; display: grid !important; gap: var(--ck-gap) !important; }
    #MainProduct-{{ section.id }} .cervia-checks__item { display: flex !important; align-items: center !important; justify-content: var(--alin-flex) !important; gap: 10px !important; font-size: var(--ck-texto) !important; font-weight: var(--ck-peso) !important; color: var(--ck-c-texto) !important; line-height: 1.35 !important; }
    #MainProduct-{{ section.id }} .cervia-checks__icono { color: var(--ck-c-icono) !important; display: inline-flex !important; }
    #MainProduct-{{ section.id }} .cervia-checks__icono .cervia-i { width: var(--ck-icono) !important; height: var(--ck-icono) !important; stroke-width: var(--ck-trazo) !important; }

    #MainProduct-{{ section.id }} .cervia-packs__titulo { font-size: 14px !important; font-weight: 600 !important; color: var(--pk-texto) !important; margin-bottom: 10px !important; }
    #MainProduct-{{ section.id }} .cervia-packs__lista { display: grid !important; gap: 10px !important; }
    #MainProduct-{{ section.id }} .cervia-pack { position: relative !important; display: grid !important; grid-template-columns: auto minmax(0, 1fr) auto !important; align-items: center !important; gap: 12px !important; padding: 16px !important; border: 1.5px solid var(--pk-borde) !important; border-radius: var(--pk-radius) !important; background: var(--pk-fondo) !important; color: var(--pk-texto) !important; cursor: pointer !important; text-align: left !important; transition: transform .15s var(--marca-ease), opacity .15s var(--marca-ease) !important; }
    #MainProduct-{{ section.id }} .cervia-pack.is-destacado { border-color: var(--pk-borde-activa) !important; }
    #MainProduct-{{ section.id }} .cervia-pack.is-activa { background: var(--pk-activa) !important; border-color: var(--pk-borde-activa) !important; border-width: 2px !important; transform: scale(1.01) !important; }
    #MainProduct-{{ section.id }} .cervia-pack:has(.cervia-pack__radio:focus-visible) { outline: 2px solid var(--pk-borde-activa) !important; outline-offset: 2px !important; }
    #MainProduct-{{ section.id }} .cervia-pack__radio { position: absolute !important; opacity: 0 !important; width: 1px !important; height: 1px !important; pointer-events: none !important; }
    #MainProduct-{{ section.id }} .cervia-pack__punto { width: 20px !important; height: 20px !important; border-radius: 50% !important; border: 1.5px solid var(--pk-borde-activa) !important; display: grid !important; place-items: center !important; }
    #MainProduct-{{ section.id }} .cervia-pack__punto::after { content: "" !important; width: 10px !important; height: 10px !important; border-radius: 50% !important; background: var(--pk-borde-activa) !important; transform: scale(0) !important; transition: transform .15s var(--marca-ease) !important; }
    #MainProduct-{{ section.id }} .cervia-pack.is-activa .cervia-pack__punto::after { transform: scale(1) !important; }
    #MainProduct-{{ section.id }} .cervia-pack__badge { position: absolute !important; top: -10px !important; right: 14px !important; padding: 3px 10px !important; border-radius: 999px !important; background: var(--pk-badge) !important; color: var(--pk-badge-texto) !important; font-size: 11px !important; font-weight: 600 !important; letter-spacing: .04em !important; text-transform: uppercase !important; line-height: 1.4 !important; }
    #MainProduct-{{ section.id }} .cervia-pack__info { display: grid !important; gap: 3px !important; min-width: 0 !important; }
    #MainProduct-{{ section.id }} .cervia-pack__etiqueta { font-size: var(--pk-nombre) !important; font-weight: 600 !important; line-height: 1.2 !important; }
    #MainProduct-{{ section.id }} .cervia-pack__sub { font-size: 13px !important; color: var(--pk-suave) !important; }
    #MainProduct-{{ section.id }} .cervia-pack__extra { display: inline-flex !important; align-items: center !important; gap: 6px !important; font-size: 12px !important; font-weight: 500 !important; color: var(--pk-suave) !important; }
    #MainProduct-{{ section.id }} .cervia-pack__extra .cervia-i { width: 16px !important; height: 16px !important; }
    #MainProduct-{{ section.id }} .cervia-pack__minis { display: flex !important; margin-top: 4px !important; }
    #MainProduct-{{ section.id }} .cervia-pack__mini { width: 28px !important; height: 28px !important; object-fit: cover !important; border-radius: 50% !important; border: 2px solid var(--pk-fondo) !important; margin-left: -8px !important; background: var(--pk-activa) !important; }
    #MainProduct-{{ section.id }} .cervia-pack__mini:first-child { margin-left: 0 !important; }
    #MainProduct-{{ section.id }} .cervia-pack__precios { display: grid !important; justify-items: end !important; gap: 3px !important; text-align: right !important; }
    #MainProduct-{{ section.id }} .cervia-pack__precio { font-size: var(--pk-precio) !important; font-weight: 700 !important; line-height: 1.1 !important; }
    #MainProduct-{{ section.id }} .cervia-pack__base { font-size: 13px !important; color: var(--pk-suave) !important; }
    #MainProduct-{{ section.id }} .cervia-pack__unidad { font-size: 12px !important; color: var(--pk-suave) !important; }
    #MainProduct-{{ section.id }} .cervia-pack__ahorro { font-size: 11px !important; font-weight: 600 !important; padding: 3px 8px !important; border-radius: 999px !important; background: var(--pk-ahorro) !important; color: var(--pk-ahorro-texto) !important; white-space: nowrap !important; }
    #MainProduct-{{ section.id }} .cervia-packs__boton { margin-top: 14px !important; width: 100% !important; min-height: var(--pk-alto) !important; display: flex !important; align-items: center !important; justify-content: center !important; gap: 10px !important; padding: 0 20px !important; border: 1.5px solid var(--pk-boton-borde) !important; border-radius: var(--pk-radius-boton) !important; background: var(--pk-boton) !important; color: var(--pk-boton-texto) !important; font-family: inherit !important; font-size: var(--pk-boton-tam) !important; font-weight: 600 !important; letter-spacing: .01em !important; cursor: pointer !important; white-space: nowrap !important; transition: transform .15s var(--marca-ease), opacity .15s var(--marca-ease) !important; }
    #MainProduct-{{ section.id }} .cervia-packs__boton:hover { background: var(--pk-boton-hover) !important; color: var(--pk-boton-texto-hover) !important; }
    #MainProduct-{{ section.id }} .cervia-packs__boton:active { transform: translateY(1px) !important; }
    #MainProduct-{{ section.id }} .cervia-packs__boton[disabled] { opacity: .5 !important; cursor: not-allowed !important; }
    #MainProduct-{{ section.id }} .cervia-packs__boton[aria-busy="true"] { opacity: .85 !important; }
    #MainProduct-{{ section.id }} .cervia-spinner { width: 18px !important; height: 18px !important; }
    #MainProduct-{{ section.id }} .cervia-packs__error { margin-top: 8px !important; font-size: 13px !important; color: #B3261E !important; }
    #MainProduct-{{ section.id }} .cervia-packs__micro { margin-top: 10px !important; text-align: center !important; font-size: 13px !important; color: var(--pk-suave) !important; }
    @media screen and (max-width: 749px) {
      #MainProduct-{{ section.id }} .is-movil-fila .cervia-packs__lista { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; }
      #MainProduct-{{ section.id }} .is-movil-fila .cervia-pack { grid-template-columns: 1fr !important; justify-items: center !important; text-align: center !important; padding: 18px 8px 12px !important; }
      #MainProduct-{{ section.id }} .is-movil-fila .cervia-pack__punto, #MainProduct-{{ section.id }} .is-movil-fila .cervia-pack__minis, #MainProduct-{{ section.id }} .is-movil-fila .cervia-pack__extra { display: none !important; }
      #MainProduct-{{ section.id }} .is-movil-fila .cervia-pack__precios { justify-items: center !important; text-align: center !important; }
      #MainProduct-{{ section.id }} .is-movil-fila .cervia-pack__badge { right: 50% !important; transform: translateX(50%) !important; white-space: nowrap !important; font-size: 10px !important; }
    }

    #MainProduct-{{ section.id }} .cervia-microcopy__texto { font-size: var(--mc) !important; color: var(--mc-c) !important; }
    #MainProduct-{{ section.id }} .cervia-pagos__texto { display: inline-flex !important; align-items: center !important; gap: 6px !important; font-size: var(--pg-texto) !important; color: var(--pg-c) !important; margin-bottom: 8px !important; }
    #MainProduct-{{ section.id }} .cervia-pagos__texto .cervia-i { width: 16px !important; height: 16px !important; }
    #MainProduct-{{ section.id }} .cervia-pagos__fila { display: flex !important; flex-wrap: wrap !important; justify-content: var(--alin-flex) !important; gap: 6px !important; }
    #MainProduct-{{ section.id }} .cervia-pagos__logo { height: var(--pg-alto) !important; width: auto !important; display: block !important; }
    #MainProduct-{{ section.id }} .cervia-pagos__fila.is-grises .cervia-pagos__logo { filter: grayscale(1) !important; opacity: .8 !important; }

    #MainProduct-{{ section.id }} .cervia-garantias__lista { list-style: none !important; margin: 0 !important; padding: var(--gr-pad) !important; display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 14px 12px !important; background: var(--gr-fondo) !important; border: 1px solid var(--gr-borde) !important; border-radius: var(--gr-radius) !important; }
    #MainProduct-{{ section.id }} .cervia-garantias__lista.is-fila { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)) !important; }
    #MainProduct-{{ section.id }} .cervia-garantias__item { display: flex !important; align-items: center !important; gap: 10px !important; text-align: left !important; min-width: 0 !important; }
    #MainProduct-{{ section.id }} .cervia-garantias__icono { display: grid !important; place-items: center !important; color: var(--gr-c-icono) !important; flex-shrink: 0 !important; width: calc(var(--gr-icono) + 16px) !important; height: calc(var(--gr-icono) + 16px) !important; }
    #MainProduct-{{ section.id }} .cervia-garantias__icono.is-circulo { border-radius: 50% !important; background: var(--gr-f-icono) !important; }
    #MainProduct-{{ section.id }} .cervia-garantias__icono.is-cuadrado { border-radius: 10px !important; background: var(--gr-f-icono) !important; }
    #MainProduct-{{ section.id }} .cervia-garantias__icono .cervia-i { width: var(--gr-icono) !important; height: var(--gr-icono) !important; stroke-width: var(--gr-trazo) !important; }
    #MainProduct-{{ section.id }} .cervia-garantias__textos { display: grid !important; gap: 2px !important; min-width: 0 !important; }
    #MainProduct-{{ section.id }} .cervia-garantias__titulo { font-size: var(--gr-titulo) !important; font-weight: 600 !important; color: var(--gr-c-titulo) !important; line-height: 1.25 !important; }
    #MainProduct-{{ section.id }} .cervia-garantias__sub { font-size: var(--gr-texto) !important; color: var(--gr-c-texto) !important; line-height: 1.3 !important; }

    #MainProduct-{{ section.id }} .cervia-envio__caja { display: flex !important; align-items: center !important; justify-content: var(--alin-flex) !important; gap: 10px !important; padding: 12px 16px !important; border-radius: var(--ev-radius) !important; background: var(--ev-fondo) !important; }
    #MainProduct-{{ section.id }} .cervia-envio__icono { color: var(--ev-c-icono) !important; display: inline-flex !important; }
    #MainProduct-{{ section.id }} .cervia-envio__icono .cervia-i { width: var(--ev-icono) !important; height: var(--ev-icono) !important; }
    #MainProduct-{{ section.id }} .cervia-envio__texto { font-size: var(--ev-texto) !important; color: var(--ev-c) !important; line-height: 1.4 !important; }

    #MainProduct-{{ section.id }} .cervia-desplegables__lista { display: grid !important; }
    #MainProduct-{{ section.id }} .cervia-desplegables__lista.is-tarjetas { gap: 8px !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable { border-bottom: 1px solid var(--ds-borde) !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable:first-child { border-top: 1px solid var(--ds-borde) !important; }
    #MainProduct-{{ section.id }} .is-tarjetas .cervia-desplegable { border: 1px solid var(--ds-borde) !important; border-radius: var(--ds-radius) !important; padding-inline: 14px !important; }
    #MainProduct-{{ section.id }} .is-tarjetas .cervia-desplegable[open] { background: var(--ds-abierta) !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable__cabecera { display: flex !important; align-items: center !important; gap: 12px !important; padding: 16px 0 !important; cursor: pointer !important; list-style: none !important; color: var(--ds-c) !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable__cabecera::-webkit-details-marker { display: none !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable__icono { color: var(--ds-c-icono) !important; display: inline-flex !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable__icono .cervia-i { width: var(--ds-icono) !important; height: var(--ds-icono) !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable__titulo { flex: 1 !important; font-size: var(--ds-titulo) !important; font-weight: 600 !important; text-align: left !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable__abrir { display: inline-flex !important; transition: transform .2s var(--marca-ease) !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable__abrir .cervia-i { width: 18px !important; height: 18px !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable[open] .cervia-desplegable__abrir.is-chevron { transform: rotate(180deg) !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable[open] .cervia-desplegable__abrir.is-plus { transform: rotate(45deg) !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable__contenido { padding: 0 0 16px !important; font-size: var(--ds-texto) !important; line-height: 1.55 !important; color: var(--ds-suave) !important; text-align: left !important; }
    #MainProduct-{{ section.id }} .cervia-desplegable__contenido p + p { margin-top: 8px !important; }
    @media (prefers-reduced-motion: reduce) {
      #MainProduct-{{ section.id }} * { transition-duration: .01ms !important; }
    }

    {%- for block in section.blocks -%}
      {%- if block.type contains 'cervia_' -%}
        #MainProduct-{{ section.id }} .product__info-container > .cervia-b-{{ block.id }} { margin-top: calc(var(--marca-gap) + {{ block.settings.margen_sup_movil }}px) !important; margin-bottom: {{ block.settings.margen_inf_movil }}px !important; }
        @media screen and (min-width: 750px) {
          #MainProduct-{{ section.id }} .product__info-container > .cervia-b-{{ block.id }} { margin-top: calc(var(--marca-gap) + {{ block.settings.margen_sup }}px) !important; margin-bottom: {{ block.settings.margen_inf }}px !important; }
        }
        #MainProduct-{{ section.id }} .product__info-container > .cervia-b-{{ block.id }}:first-child { margin-top: {{ block.settings.margen_sup_movil }}px !important; }
      {%- endif -%}
      {%- case block.type -%}
        {%- when 'cervia_titulo' -%}
        .cervia-b-{{ block.id }} { --eyebrow: {{ block.settings.tam_eyebrow_movil }}px; --titulo: {{ block.settings.tam_titulo_movil }}px; --sub: {{ block.settings.tam_sub_movil }}px; --estrellas: {{ block.settings.tam_estrellas }}px; --c-eyebrow: {{ block.settings.color_eyebrow }}; --c-titulo: {{ block.settings.color_titulo }}; --c-sub: {{ block.settings.color_sub }}; --c-estrella: {{ block.settings.color_estrellas }}; --c-estrella-vacia: {{ block.settings.color_estrellas_vacio }}; --peso-titulo: {{ block.settings.peso_titulo }}; }
        @media screen and (min-width: 750px) { .cervia-b-{{ block.id }} { --eyebrow: {{ block.settings.tam_eyebrow }}px; --titulo: {{ block.settings.tam_titulo }}px; --sub: {{ block.settings.tam_sub }}px; } }
        {%- when 'cervia_precio' -%}
        .cervia-b-{{ block.id }} { --precio: {{ block.settings.tam_precio_movil }}px; --c-precio: {{ block.settings.color_precio }}; --c-tachado: {{ block.settings.color_tachado }}; --c-chip: {{ block.settings.color_ahorro }}; --c-chip-texto: {{ block.settings.color_ahorro_texto }}; --c-nota: {{ block.settings.color_nota }}; --nota: {{ block.settings.tam_nota }}px; }
        @media screen and (min-width: 750px) { .cervia-b-{{ block.id }} { --precio: {{ block.settings.tam_precio }}px; } }
        {%- when 'cervia_separador' -%}
        .cervia-b-{{ block.id }} { --grosor: {{ block.settings.grosor }}px; --c-linea: {{ block.settings.color }}; --c-sep-texto: {{ block.settings.color_texto }}; --sep-texto: {{ block.settings.tam_texto }}px; }
        {%- when 'cervia_checks' -%}
        .cervia-b-{{ block.id }} { --ck-icono: {{ block.settings.tam_icono }}px; --ck-c-icono: {{ block.settings.color_icono }}; --ck-trazo: {{ block.settings.trazo }}; --ck-texto: {{ block.settings.tam_texto_movil }}px; --ck-peso: {{ block.settings.peso }}; --ck-c-texto: {{ block.settings.color_texto }}; --ck-gap: {{ block.settings.gap }}px; }
        @media screen and (min-width: 750px) { .cervia-b-{{ block.id }} { --ck-texto: {{ block.settings.tam_texto }}px; } }
        {%- when 'cervia_packs' -%}
        .cervia-b-{{ block.id }} { --pk-fondo: {{ block.settings.color_tarjeta }}; --pk-borde: {{ block.settings.color_borde }}; --pk-activa: {{ block.settings.color_activa }}; --pk-borde-activa: {{ block.settings.color_borde_activa }}; --pk-texto: {{ block.settings.color_texto }}; --pk-suave: {{ block.settings.color_suave }}; --pk-badge: {{ block.settings.color_badge }}; --pk-badge-texto: {{ block.settings.color_badge_texto }}; --pk-ahorro: {{ block.settings.color_ahorro }}; --pk-ahorro-texto: {{ block.settings.color_ahorro_texto }}; --pk-boton: {{ block.settings.color_boton }}; --pk-boton-texto: {{ block.settings.color_boton_texto }}; --pk-boton-borde: {{ block.settings.color_boton_borde }}; --pk-boton-hover: {{ block.settings.color_boton_hover }}; --pk-boton-texto-hover: {{ block.settings.color_boton_texto_hover }}; --pk-radius: {{ block.settings.radius }}px; --pk-radius-boton: {{ block.settings.radius_boton }}px; --pk-nombre: {{ block.settings.tam_nombre_movil }}px; --pk-precio: {{ block.settings.tam_precio_movil }}px; --pk-alto: {{ block.settings.alto_boton_movil }}px; --pk-boton-tam: {{ block.settings.tam_boton_movil }}px; }
        @media screen and (min-width: 750px) { .cervia-b-{{ block.id }} { --pk-nombre: {{ block.settings.tam_nombre }}px; --pk-precio: {{ block.settings.tam_precio }}px; --pk-alto: {{ block.settings.alto_boton }}px; --pk-boton-tam: {{ block.settings.tam_boton }}px; } }
        {%- when 'cervia_microcopy' -%}
        .cervia-b-{{ block.id }} { --mc: {{ block.settings.tam }}px; --mc-c: {{ block.settings.color }}; }
        {%- when 'cervia_pagos' -%}
        .cervia-b-{{ block.id }} { --pg-alto: {{ block.settings.alto }}px; --pg-texto: {{ block.settings.tam_texto }}px; --pg-c: {{ block.settings.color_texto }}; }
        {%- when 'cervia_garantias' -%}
        .cervia-b-{{ block.id }} { --gr-icono: {{ block.settings.tam_icono }}px; --gr-trazo: {{ block.settings.trazo }}; --gr-c-icono: {{ block.settings.color_icono }}; --gr-f-icono: {{ block.settings.fondo_icono }}; --gr-titulo: {{ block.settings.tam_titulo_movil }}px; --gr-texto: {{ block.settings.tam_texto }}px; --gr-c-titulo: {{ block.settings.color_titulo }}; --gr-c-texto: {{ block.settings.color_texto }}; --gr-fondo: {{ block.settings.color_fondo }}; --gr-borde: {{ block.settings.color_borde }}; --gr-radius: {{ block.settings.radius }}px; --gr-pad: {{ block.settings.padding }}px; }
        @media screen and (min-width: 750px) { .cervia-b-{{ block.id }} { --gr-titulo: {{ block.settings.tam_titulo }}px; } }
        {%- when 'cervia_envio' -%}
        .cervia-b-{{ block.id }} { --ev-texto: {{ block.settings.tam_texto }}px; --ev-c: {{ block.settings.color_texto }}; --ev-c-icono: {{ block.settings.color_icono }}; --ev-fondo: {{ block.settings.color_fondo }}; --ev-radius: {{ block.settings.radius }}px; --ev-icono: {{ block.settings.tam_icono }}px; }
        {%- when 'cervia_desplegables' -%}
        .cervia-b-{{ block.id }} { --ds-titulo: {{ block.settings.tam_titulo_movil }}px; --ds-texto: {{ block.settings.tam_texto }}px; --ds-icono: {{ block.settings.tam_icono }}px; --ds-c: {{ block.settings.color_texto }}; --ds-suave: {{ block.settings.color_suave }}; --ds-c-icono: {{ block.settings.color_icono }}; --ds-borde: {{ block.settings.color_borde }}; --ds-abierta: {{ block.settings.color_abierta }}; --ds-radius: {{ block.settings.radius }}px; }
        @media screen and (min-width: 750px) { .cervia-b-{{ block.id }} { --ds-titulo: {{ block.settings.tam_titulo }}px; } }
      {%- endcase -%}
    {%- endfor -%}
  {%- endstyle -%}
  <script>
    (() => {
      if (window.marcaCervia) return;
      const money = (cents) => new Intl.NumberFormat(document.documentElement.lang || 'es', { style: 'currency', currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR' }).format((cents || 0) / 100);
      const track = (activo, evento, variantId, quantity, priceCents) => {
        if (!activo) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: evento, variant_id: variantId, quantity, value: ((priceCents || 0) * quantity) / 100, currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR' });
      };
      async function addToCart(variantId, quantity, source) {
        const cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
        if (!cart) {
          const r = await fetch(routes.cart_add_url, { ...fetchConfig('javascript'), body: JSON.stringify({ items: [{ id: variantId, quantity }] }) });
          const s = await r.json();
          if (!s.status) window.location.href = routes.cart_url;
          return s;
        }
        const body = { items: [{ id: variantId, quantity }], sections: cart.getSectionsToRender().map((s) => s.id), sections_url: window.location.pathname };
        const response = await fetch(routes.cart_add_url, { ...fetchConfig('javascript'), body: JSON.stringify(body) });
        const state = await response.json();
        if (state.status) {
          publish(PUB_SUB_EVENTS.cartError, { source, productVariantId: variantId, errors: state.errors || state.description, message: state.message });
          return state;
        }
        publish(PUB_SUB_EVENTS.cartUpdate, { source, productVariantId: variantId, cartData: state });
        cart.renderContents(state);
        cart.classList.remove('is-empty');
        cart.querySelector('.drawer__inner')?.classList.remove('is-empty');
        return state;
      }
      window.marcaCervia = { money, track, addToCart };

      if (!customElements.get('marca-miniaturas')) {
        class MarcaMiniaturas extends HTMLElement {
          connectedCallback() {
            this.lista = this.closest('product-info')?.querySelector('.thumbnail-list');
            if (!this.lista) return;
            this.onClick = (e) => { const b = e.target.closest('.thumbnail'); if (b) requestAnimationFrame(() => b.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' })); };
            this.lista.addEventListener('click', this.onClick);
            this.mo = new MutationObserver(() => { const a = this.lista.querySelector('.thumbnail[aria-current]'); if (a && window.matchMedia('(max-width: 749px)').matches) a.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' }); });
            this.mo.observe(this.lista, { attributes: true, subtree: true, attributeFilter: ['aria-current'] });
          }
          disconnectedCallback() { this.lista?.removeEventListener('click', this.onClick); this.mo?.disconnect(); }
        }
        customElements.define('marca-miniaturas', MarcaMiniaturas);
      }

      if (!customElements.get('marca-precio-sync')) {
        class MarcaPrecioSync extends HTMLElement {
          connectedCallback() {
            if (typeof subscribe !== 'function') return;
            this.unsubscribe = subscribe(PUB_SUB_EVENTS.variantChange, ({ data }) => this.render(data.variant));
          }
          disconnectedCallback() { this.unsubscribe?.(); }
          render(variant) {
            if (!variant) return;
            const raiz = this.closest('product-info') || document;
            raiz.querySelectorAll('[data-marca-precio]').forEach((el) => {
              const precio = el.querySelector('[data-precio]');
              const anterior = el.querySelector('[data-anterior]');
              const ahorro = el.querySelector('[data-ahorro]');
              if (precio) precio.textContent = money(variant.price);
              const hay = variant.compare_at_price && variant.compare_at_price > variant.price;
              if (anterior) { anterior.hidden = !hay; if (hay) anterior.textContent = money(variant.compare_at_price); }
              if (ahorro) {
                ahorro.hidden = !hay;
                if (hay) {
                  const diff = variant.compare_at_price - variant.price;
                  const valor = el.dataset.formato === 'importe' ? money(diff) : Math.round((diff / variant.compare_at_price) * 100) + '%';
                  ahorro.textContent = (el.dataset.textoAhorro || '').replace('[[valor]]', valor);
                }
              }
            });
          }
        }
        customElements.define('marca-precio-sync', MarcaPrecioSync);
      }

      if (!customElements.get('marca-packs')) {
        class MarcaPacks extends HTMLElement {
          connectedCallback() {
            this.boton = this.querySelector('[data-boton]');
            this.textoBoton = this.querySelector('[data-boton-texto]');
            this.spinner = this.querySelector('.cervia-spinner');
            this.error = this.querySelector('.cervia-packs__error');
            this.variantId = Number(this.dataset.variantId);
            this.precio = Number(this.dataset.precio);
            this.disponible = this.dataset.disponible === 'true';
            this.tarjetas = [...this.querySelectorAll('.cervia-pack')];
            if (!this.tarjetas.some((t) => t.querySelector('input').checked) && this.tarjetas[0]) this.tarjetas[0].querySelector('input').checked = true;
            this.addEventListener('change', (e) => {
              if (!e.target.matches('.cervia-pack__radio')) return;
              this.render();
              const t = this.activa();
              if (t) track(this.dataset.tracking === 'true', 'marca_select_pack', this.idActual(), Number(t.dataset.unidades), this.precio);
            });
            this.boton?.addEventListener('click', () => this.comprar());
            if (typeof subscribe === 'function') {
              this.unsubscribe = subscribe(PUB_SUB_EVENTS.variantChange, ({ data }) => {
                if (!data.variant) { this.disponible = false; this.render(); return; }
                this.variantId = data.variant.id;
                this.precio = data.variant.price;
                this.disponible = data.variant.available;
                this.render();
              });
            }
            this.render();
          }
          disconnectedCallback() { this.unsubscribe?.(); }
          activa() { return this.tarjetas.find((t) => t.querySelector('input').checked); }
          idActual() {
            const input = document.querySelector('form[id^="product-form-"] input[name="id"]');
            return input && input.value ? Number(input.value) : this.variantId;
          }
          calcular(t) {
            const u = Number(t.dataset.unidades) || 1;
            const d = Number(t.dataset.descuento) || 0;
            const base = this.precio * u;
            const fijo = Number(t.dataset.fijo) || 0;
            const total = fijo > 0 ? fijo : Math.floor((base * (100 - d)) / 100);
            const ahorro = base - total;
            return { u, d, base, total, unidad: Math.floor(total / u), ahorro, pct: base > 0 ? Math.floor((ahorro * 100) / base) : 0 };
          }
          render() {
            this.tarjetas.forEach((t) => {
              const c = this.calcular(t);
              t.classList.toggle('is-activa', t.querySelector('input').checked);
              const total = t.querySelector('[data-total]');
              const base = t.querySelector('[data-base]');
              const unidad = t.querySelector('[data-unidad]');
              const ahorro = t.querySelector('[data-ahorro]');
              if (total) total.textContent = money(c.total);
              if (base) { base.textContent = money(c.base); base.hidden = c.ahorro <= 0; }
              if (unidad) { unidad.textContent = (this.dataset.textoUnidad || '').replace('[[precio]]', money(c.unidad)); unidad.hidden = c.u === 1; }
              if (ahorro) {
                ahorro.textContent = (this.dataset.textoAhorro || '').replace('[[valor]]', this.dataset.formato === 'porcentaje' ? c.pct + '%' : money(c.ahorro));
                ahorro.hidden = c.ahorro <= 0;
              }
            });
            const t = this.activa();
            if (!this.boton || !this.textoBoton) return;
            if (!this.disponible || !t) {
              this.boton.disabled = true;
              this.textoBoton.textContent = this.dataset.textoAgotado || '';
              return;
            }
            this.boton.disabled = false;
            this.textoBoton.textContent = (this.dataset.textoBoton || '').replace('[[precio]]', money(this.calcular(t).total));
          }
          async comprar() {
            const t = this.activa();
            if (!t || !this.disponible) return;
            const u = Number(t.dataset.unidades) || 1;
            const id = this.idActual();
            const activo = this.dataset.tracking === 'true';
            if (this.dataset.accion === 'checkout') {
              track(activo, 'marca_initiate_checkout', id, u, this.precio);
              window.location.href = `${routes.cart_url}/${id}:${u}`;
              return;
            }
            this.error.hidden = true;
            this.boton.setAttribute('aria-busy', 'true');
            this.boton.disabled = true;
            this.spinner.hidden = false;
            this.textoBoton.textContent = this.dataset.textoCargando || '';
            try {
              const state = await addToCart(id, u, 'marca-packs');
              if (state && state.status) {
                this.error.textContent = state.description || state.message || '';
                this.error.hidden = false;
              } else {
                track(activo, 'marca_add_to_cart', id, u, this.calcular(t).total / u);
              }
            } catch (e) {
              this.error.textContent = e.message || 'Error';
              this.error.hidden = false;
            } finally {
              this.boton.removeAttribute('aria-busy');
              this.spinner.hidden = true;
              this.render();
            }
          }
        }
        customElements.define('marca-packs', MarcaPacks);
      }

      if (!customElements.get('marca-envio')) {
        class MarcaEnvio extends HTMLElement {
          connectedCallback() {
            const finde = this.dataset.finde === 'true';
            const sumar = (dias) => {
              const d = new Date();
              let n = 0;
              while (n < dias) {
                d.setDate(d.getDate() + 1);
                if (!finde || (d.getDay() !== 0 && d.getDay() !== 6)) n += 1;
              }
              return d;
            };
            let fmt;
            try { fmt = new Intl.DateTimeFormat(this.dataset.locale || 'es-ES', { day: 'numeric', month: 'long' }); } catch (e) { fmt = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long' }); }
            const min = this.querySelector('[data-fecha-min]');
            const max = this.querySelector('[data-fecha-max]');
            if (min) min.textContent = fmt.format(sumar(Number(this.dataset.min) || 0));
            if (max) max.textContent = fmt.format(sumar(Number(this.dataset.max) || 0));
          }
        }
        customElements.define('marca-envio', MarcaEnvio);
      }

      if (!customElements.get('marca-desplegables')) {
        class MarcaDesplegables extends HTMLElement {
          connectedCallback() {
            if (this.dataset.una !== 'true') return;
            this.addEventListener('toggle', (e) => {
              const d = e.target;
              if (!(d instanceof HTMLDetailsElement) || !d.open) return;
              this.querySelectorAll('details[open]').forEach((o) => { if (o !== d) o.open = false; });
            }, true);
          }
        }
        customElements.define('marca-desplegables', MarcaDesplegables);
      }
    })();
  </script>
  <marca-miniaturas hidden></marca-miniaturas>
  <marca-precio-sync hidden></marca-precio-sync>
  <svg hidden aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg"><symbol id="cervia-i-check-{{ section.id }}" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></symbol><symbol id="cervia-i-check_circulo-{{ section.id }}" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.8 2.8L16 9.5"/></symbol><symbol id="cervia-i-escudo_check-{{ section.id }}" viewBox="0 0 24 24"><path d="M12 3l7 3v5.5c0 4.5-3 8-7 9.5-4-1.5-7-5-7-9.5V6z"/><path d="M9 12l2.2 2.2L15.5 10"/></symbol><symbol id="cervia-i-camion-{{ section.id }}" viewBox="0 0 24 24"><path d="M3 6.5h11v9.5H3zM14 9.5h3.8l3.2 3.2V16H14"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></symbol><symbol id="cervia-i-caja-{{ section.id }}" viewBox="0 0 24 24"><path d="M3.5 7.5L12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5L12 12l8.5-4.5M12 12v9"/></symbol><symbol id="cervia-i-candado-{{ section.id }}" viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></symbol><symbol id="cervia-i-ciclo-{{ section.id }}" viewBox="0 0 24 24"><path d="M20 11a8 8 0 0 0-14.5-4.5L4 8M4 4v4h4M4 13a8 8 0 0 0 14.5 4.5L20 16M20 20v-4h-4"/></symbol><symbol id="cervia-i-chat-{{ section.id }}" viewBox="0 0 24 24"><path d="M4 5h16v11H9.5L4 20z"/><path d="M8.5 10.5h7"/></symbol><symbol id="cervia-i-hoja-{{ section.id }}" viewBox="0 0 24 24"><path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14z"/><path d="M5 19l7-7"/></symbol><symbol id="cervia-i-luna-{{ section.id }}" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></symbol><symbol id="cervia-i-estrella-{{ section.id }}" viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.8z"/></symbol><symbol id="cervia-i-regalo-{{ section.id }}" viewBox="0 0 24 24"><rect x="4" y="8.5" width="16" height="4" rx="1"/><path d="M5.5 12.5V20h13v-7.5M12 8.5V20M12 8.5c-1.5-3-5-3.5-5-1.2s3 1.2 5 1.2c2 0 5 1.1 5-1.2s-3.5-1.8-5 1.2z"/></symbol><symbol id="cervia-i-corazon-{{ section.id }}" viewBox="0 0 24 24"><path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/></symbol><symbol id="cervia-i-reloj-{{ section.id }}" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/></symbol><symbol id="cervia-i-tarjeta-{{ section.id }}" viewBox="0 0 24 24"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18M7 14.5h3"/></symbol><symbol id="cervia-i-info-{{ section.id }}" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></symbol><symbol id="cervia-i-almohada-{{ section.id }}" viewBox="0 0 24 24"><path d="M4 9.5C4 7.5 5.5 6.5 7.5 7c3 .8 6 .8 9 0 2-.5 3.5.5 3.5 2.5v5c0 2-1.5 3-3.5 2.5-3-.8-6-.8-9 0C5.5 17.5 4 16.5 4 14.5z"/><path d="M8 12c2.6.7 5.4.7 8 0"/></symbol><symbol id="cervia-i-chevron-{{ section.id }}" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol><symbol id="cervia-i-plus-{{ section.id }}" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol></svg>

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
