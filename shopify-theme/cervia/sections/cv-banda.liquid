{%- comment -%}
  Cervia Vivo: banda de frases que se desplaza sola.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} { margin: 0 !important; }
  #shopify-section-{{ section.id }} + .shopify-section { margin-top: 0 !important; }
  #shopify-section-{{ section.id }} .cv-bd { overflow: hidden; background: {{ section.settings.color_fondo }}; color: {{ section.settings.color_texto }}; font-family: var(--font-body, var(--font-body-family)); }
  #shopify-section-{{ section.id }} .cv-bd__pista { display: flex; width: max-content; animation: cv-bd-{{ section.id }} {{ section.settings.velocidad }}s linear infinite; }
  #shopify-section-{{ section.id }} .cv-bd__grupo { display: flex; flex-shrink: 0; }
  #shopify-section-{{ section.id }} .cv-bd__item { display: inline-flex; align-items: center; gap: 18px; padding: {{ section.settings.alto }}px 0 {{ section.settings.alto }}px 18px; font-size: {{ section.settings.tam }}px; font-weight: 800; letter-spacing: .02em; text-transform: uppercase; white-space: nowrap; }
  #shopify-section-{{ section.id }} .cv-bd__item::after { content: "✦"; color: {{ section.settings.color_estrella }}; }
  @keyframes cv-bd-{{ section.id }} { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ section.id }} .cv-bd__pista { animation: none; } }
  @media screen and (max-width: 749px) { #shopify-section-{{ section.id }} .cv-bd__item { font-size: {{ section.settings.tam | minus: 3 }}px; } }
{%- endstyle -%}

{%- assign frases = section.settings.frases | split: '|' -%}
<div class="cv-bd" role="region" aria-label="Ventajas de Cervia">
  <div class="cv-bd__pista">
    {%- for vuelta in (1..2) -%}
      <div class="cv-bd__grupo"{% if vuelta == 2 %} aria-hidden="true"{% endif %}>
        {%- for repe in (1..3) -%}
          {%- for f in frases -%}<span class="cv-bd__item">{{ f | strip }}</span>{%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Cervia Vivo · Banda",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "frases", "label": "Frases", "info": "Sepáralas con |", "default": "Envío gratis a toda España | 30 días de prueba | −15 % en el combo | Pago seguro" },
    { "type": "range", "id": "tam", "label": "Tamaño del texto", "min": 12, "max": 28, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "alto", "label": "Espacio vertical", "min": 6, "max": 30, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "velocidad", "label": "Duración de una vuelta", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 35 },
    { "type": "color", "id": "color_fondo", "label": "Fondo", "default": "#2D5BFF" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#FFFFFF" },
    { "type": "color", "id": "color_estrella", "label": "Separador", "default": "#FFD23F" }
  ],
  "presets": [{ "name": "Cervia Vivo · Banda" }]
}
{% endschema %}
