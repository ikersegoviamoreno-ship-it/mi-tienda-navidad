<script>
  (() => {
    const f = document.querySelector('#shopify-section-{{ section.id }} .cervia-f');
    if (!f) return;
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pista = f.querySelector('[data-pista]');
    if (pista && !reducido) {
      let x = 0; let pausa = false; let ultimo = performance.now(); let visible = true;
      const vel = Number(f.dataset.marqueeVel) || 30;
      if (f.dataset.pausa === 'true') { pista.addEventListener('mouseenter', () => { pausa = true; }); pista.addEventListener('mouseleave', () => { pausa = false; }); }
      if ('IntersectionObserver' in window) new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(pista);
      const paso = (t) => {
        const dt = t - ultimo; ultimo = t;
        const ancho = pista.firstElementChild ? pista.firstElementChild.offsetWidth : 0;
        if (!pausa && visible && ancho > 0) { x -= (ancho / (vel * 1000)) * dt; if (-x >= ancho) x += ancho; pista.style.transform = `translate3d(${x}px,0,0)`; }
        requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    }
    if (f.dataset.animConf === 'true' && !reducido && 'IntersectionObserver' in window && !(window.Shopify && Shopify.designMode)) {
      const items = f.querySelectorAll('.cervia-f__conf-item');
      if (!items.length) return;
      f.classList.add('is-anim');
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }), { threshold: 0.2 });
      items.forEach((i) => io.observe(i));
    }
  })();
</script>
<script>
  (() => {
    if (!window.marcaCervia) {
      const money = (cents) => new Intl.NumberFormat(document.documentElement.lang || 'es', { style: 'currency', currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR' }).format((cents || 0) / 100);
      const track = (activo, evento, variantId, quantity, priceCents) => {
        if (!activo) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: evento, variant_id: variantId, quantity, value: ((priceCents || 0) * quantity) / 100, currency: (window.Shopify && Shopify.currency && Shopify.currency.active) || 'EUR' });
      };
      async function addToCart(variantId, quantity, source) {
        const cart = document.querySelector('cart-drawer') || document.querySelector('cart-notification');
        if (!cart) {
          const r = await fetch(routes.cart_add_url, { ...fetchConfig('javascript'), body: JSON.stringify({ items: [{ id: variantId, quantity }] }) });
          const s = await r.json();
          if (!s.status) window.location.href = routes.cart_url;
          return s;
        }
        const body = { items: [{ id: variantId, quantity }], sections: cart.getSectionsToRender().map((s) => s.id), sections_url: window.location.pathname };
        const response = await fetch(routes.cart_add_url, { ...fetchConfig('javascript'), body: JSON.stringify(body) });
        const state = await response.json();
        if (state.status) {
          publish(PUB_SUB_EVENTS.cartError, { source, productVariantId: variantId, errors: state.errors || state.description, message: state.message });
          return state;
        }
        publish(PUB_SUB_EVENTS.cartUpdate, { source, productVariantId: variantId, cartData: state });
        cart.renderContents(state);
        cart.classList.remove('is-empty');
        cart.querySelector('.drawer__inner')?.classList.remove('is-empty');
        return state;
      }
      window.marcaCervia = { money, track, addToCart };
    }
    if (customElements.get('cervia-cta')) return;
    class CerviaCta extends HTMLElement {
      connectedCallback() { if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', () => { if (this.isConnected) this.connectedCallback(); }, { once: true }); return; }
        this.boton = this.querySelector('[data-boton]');
        this.texto = this.querySelector('[data-texto-boton]');
        this.spinner = this.querySelector('.cervia-cta__spinner');
        this.error = this.querySelector('.cervia-cta__error');
        this.variantId = Number(this.dataset.variantId);
        this.precio = Number(this.dataset.precio);
        this.disponible = this.dataset.disponible === 'true';
        this.boton?.addEventListener('click', () => this.accion());
        if (this.dataset.externo !== 'true' && typeof subscribe === 'function') {
          this.unsubscribe = subscribe(PUB_SUB_EVENTS.variantChange, ({ data }) => {
            if (!data.variant) { this.disponible = false; this.render(); return; }
            this.variantId = data.variant.id; this.precio = data.variant.price; this.disponible = data.variant.available; this.render();
          });
        }
      }
      disconnectedCallback() { this.unsubscribe?.(); }
      idActual() {
        if (this.dataset.externo === 'true') return this.variantId;
        const input = document.querySelector('form[id^="product-form-"] input[name="id"]');
        return input && input.value ? Number(input.value) : this.variantId;
      }
      render() {
        if (!this.boton || !this.texto) return;
        const sinCompra = this.dataset.accion === 'formulario' || this.dataset.accion === 'url';
        if (!this.disponible && !sinCompra) { this.boton.disabled = true; this.texto.textContent = this.dataset.textoAgotado || ''; return; }
        this.boton.disabled = false;
        this.texto.textContent = (this.dataset.texto || '').replace('[[precio]]', window.marcaCervia.money(this.precio * (Number(this.dataset.cantidad) || 1)));
      }
      async accion() {
        const accion = this.dataset.accion;
        const u = Number(this.dataset.cantidad) || 1;
        const id = this.idActual();
        const activo = this.dataset.tracking === 'true';
        if (accion === 'url' && this.dataset.url) { window.location.href = this.dataset.url; return; }
        if (accion === 'formulario' || !id) {
          const destino = document.querySelector('.cervia-packs') || document.querySelector('form[id^="product-form-"]') || document.querySelector('product-info');
          destino?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        if (accion === 'checkout') { window.marcaCervia.track(activo, 'marca_initiate_checkout', id, u, this.precio); window.location.href = `${routes.cart_url}/${id}:${u}`; return; }
        this.error.hidden = true;
        this.boton.disabled = true;
        this.boton.setAttribute('aria-busy', 'true');
        this.spinner.hidden = false;
        this.texto.textContent = this.dataset.textoCargando || '';
        try {
          const state = await window.marcaCervia.addToCart(id, u, 'cervia-cta');
          if (state && state.status) { this.error.textContent = state.description || state.message || ''; this.error.hidden = false; }
          else window.marcaCervia.track(activo, 'marca_add_to_cart', id, u, this.precio);
        } catch (e) { this.error.textContent = e.message || 'Error'; this.error.hidden = false; }
        finally { this.boton.removeAttribute('aria-busy'); this.spinner.hidden = true; this.render(); }
      }
    }
    customElements.define('cervia-cta', CerviaCta);
  })();
</script>
