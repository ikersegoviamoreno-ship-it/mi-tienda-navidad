      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Frase superior",
      "default": "El problema"
    },
    {
      "type": "inline_richtext",
      "id": "titulo",
      "label": "Título",
      "default": "¿Te levantas con el <span>cuello cargado</span>?",
      "info": "Pon entre <span> la palabra que quieras destacar con el color de acento"
    },
    {
      "type": "select",
      "id": "etiqueta",
      "label": "Etiqueta del título",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "div",
          "label": "Texto"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "mostrar_sub",
      "label": "Mostrar subtítulo",
      "default": true
    },
    {
      "type": "text",
      "id": "sub",
      "label": "Subtítulo",
      "default": "Muchas veces no es el cuello: es la almohada que lo dobla toda la noche."
