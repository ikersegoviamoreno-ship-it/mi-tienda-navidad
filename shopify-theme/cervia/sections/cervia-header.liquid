{%- style -%}
  #shopify-section-{{ section.id }} { {% if section.settings.sticky %}position: sticky !important; top: 0 !important; z-index: 20 !important;{% else %}position: relative !important; z-index: 3 !important;{% endif %} }
  #shopify-section-{{ section.id }} .cervia-h { --c-fondo: {{ section.settings.color_fondo }}; --c-texto: {{ section.settings.color_texto }}; --c-icono: {{ section.settings.color_icono }}; --c-panel: {{ section.settings.color_panel }}; --ancho: {{ section.settings.ancho }}px; --ease: cubic-bezier(.22,.8,.35,1); --logo: {{ section.settings.alto_logo_movil }}px; font-family: var(--font-body, var(--font-body-family)) !important; color: var(--c-texto) !important; }
  @media screen and (min-width: 750px) { #shopify-section-{{ section.id }} .cervia-h { --logo: {{ section.settings.alto_logo }}px; } }
  #shopify-section-{{ section.id }} .cervia-h *, #shopify-section-{{ section.id }} .cervia-h *::before, #shopify-section-{{ section.id }} .cervia-h *::after { box-sizing: border-box !important; }
  #shopify-section-{{ section.id }} .cervia-h__anuncio { background: {{ section.settings.anuncio_fondo }} !important; color: {{ section.settings.anuncio_texto }} !important; text-align: center !important; font-size: {{ section.settings.tam_anuncio }}px !important; font-weight: 500 !important; padding: 9px 16px !important; letter-spacing: .02em !important; }
  #shopify-section-{{ section.id }} .cervia-h__anuncio p { margin: 0 !important; }
  #shopify-section-{{ section.id }} .cervia-h__barra { background: var(--c-fondo) !important; {% if section.settings.borde_inferior %}border-bottom: 1px solid {{ section.settings.color_borde }} !important;{% endif %} padding-top: {{ section.settings.padding_superior_movil }}px !important; padding-bottom: {{ section.settings.padding_inferior_movil }}px !important; }
  @media screen and (min-width: 750px) { #shopify-section-{{ section.id }} .cervia-h__barra { padding-top: {{ section.settings.padding_superior }}px !important; padding-bottom: {{ section.settings.padding_inferior }}px !important; } }
  #shopify-section-{{ section.id }} .cervia-h__fila { max-width: var(--ancho) !important; margin-inline: auto !important; padding-inline: {{ section.settings.lateral_movil }}px !important; display: grid !important; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) !important; align-items: center !important; gap: 12px !important; }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cervia-h__fila { padding-inline: 40px !important; }
    #shopify-section-{{ section.id }} .cervia-h__fila.is-logo-izquierda { grid-template-columns: auto minmax(0, 1fr) auto !important; }
  }
  #shopify-section-{{ section.id }} .cervia-h__izq { display: flex !important; align-items: center !important; justify-content: flex-start !important; gap: 8px !important; }
  #shopify-section-{{ section.id }} .cervia-h__der { display: flex !important; align-items: center !important; justify-content: flex-end !important; }
  #shopify-section-{{ section.id }} .cervia-h__logo { display: flex !important; align-items: center !important; justify-content: center !important; text-decoration: none !important; color: var(--c-texto) !important; }
  #shopify-section-{{ section.id }} .cervia-h__logo img { height: var(--logo) !important; width: auto !important; display: block !important; }
  #shopify-section-{{ section.id }} .cervia-h__logo-texto { font-family: var(--font-heading, var(--font-heading-family)) !important; font-size: calc(var(--logo) * 1.05) !important; font-weight: 600 !important; letter-spacing: .02em !important; line-height: 1 !important; }
  #shopify-section-{{ section.id }} .cervia-h__btn { width: 44px !important; height: 44px !important; display: inline-grid !important; place-items: center !important; position: relative !important; border: 0 !important; background: transparent !important; color: var(--c-icono) !important; cursor: pointer !important; text-decoration: none !important; border-radius: 50% !important; padding: 0 !important; }
  #shopify-section-{{ section.id }} .cervia-h__btn:focus-visible, #shopify-section-{{ section.id }} .cervia-h__logo:focus-visible, #shopify-section-{{ section.id }} .cervia-h__panel a:focus-visible { outline: 2px solid var(--c-icono) !important; outline-offset: 2px !important; }
  #shopify-section-{{ section.id }} .cervia-h-i { width: 24px !important; height: 24px !important; fill: none !important; stroke: currentColor !important; stroke-width: 1.75 !important; stroke-linecap: round !important; stroke-linejoin: round !important; display: block !important; }
  #shopify-section-{{ section.id }} .cervia-h__contador { position: absolute !important; top: 4px !important; right: 2px !important; min-width: 18px !important; height: 18px !important; padding: 0 5px !important; border-radius: 999px !important; background: {{ section.settings.color_contador }} !important; color: {{ section.settings.color_contador_texto }} !important; font-size: 11px !important; font-weight: 700 !important; line-height: 18px !important; text-align: center !important; }
  #shopify-section-{{ section.id }} .cervia-h__contador[hidden] { display: none !important; }
  #shopify-section-{{ section.id }} .cervia-h__menu { position: fixed !important; inset: 0 !important; z-index: 100 !important; visibility: hidden !important; pointer-events: none !important; }
  #shopify-section-{{ section.id }} .cervia-h__menu.is-abierto { visibility: visible !important; pointer-events: auto !important; }
  #shopify-section-{{ section.id }} .cervia-h__velo { position: absolute !important; inset: 0 !important; background: color-mix(in srgb, var(--c-texto) 45%, transparent) !important; opacity: 0 !important; transition: opacity .25s var(--ease) !important; border: 0 !important; width: 100% !important; cursor: pointer !important; }
  #shopify-section-{{ section.id }} .cervia-h__menu.is-abierto .cervia-h__velo { opacity: 1 !important; }
  #shopify-section-{{ section.id }} .cervia-h__panel { position: absolute !important; top: 0 !important; bottom: 0 !important; {% if section.settings.lado_menu == 'derecha' %}right: 0 !important; transform: translateX(100%) !important;{% else %}left: 0 !important; transform: translateX(-100%) !important;{% endif %} width: min(86vw, 360px) !important; background: var(--c-panel) !important; color: var(--c-texto) !important; padding: 20px !important; display: flex !important; flex-direction: column !important; gap: 8px !important; transition: transform .3s var(--ease) !important; overflow-y: auto !important; }
  #shopify-section-{{ section.id }} .cervia-h__menu.is-abierto .cervia-h__panel { transform: none !important; }
  #shopify-section-{{ section.id }} .cervia-h__panel-cab { display: flex !important; align-items: center !important; justify-content: space-between !important; margin-bottom: 12px !important; font-weight: 600 !important; font-size: 16px !important; }
  #shopify-section-{{ section.id }} .cervia-h__panel ul { list-style: none !important; margin: 0 !important; padding: 0 !important; display: grid !important; }
  #shopify-section-{{ section.id }} .cervia-h__panel a.cervia-h__link { display: block !important; padding: 14px 0 !important; border-bottom: 1px solid {{ section.settings.color_borde }} !important; color: var(--c-texto) !important; text-decoration: none !important; font-size: 17px !important; }
  #shopify-section-{{ section.id }} .cervia-h__nav { list-style: none !important; margin: 0 !important; padding: 0 !important; display: flex !important; align-items: center !important; gap: 24px !important; }
  #shopify-section-{{ section.id }} .cervia-h__nav a { color: var(--c-texto) !important; text-decoration: none !important; font-size: 15px !important; font-weight: 500 !important; padding: 6px 0 !important; border-bottom: 2px solid transparent !important; transition: border-color .2s var(--ease), color .2s var(--ease) !important; }
  #shopify-section-{{ section.id }} .cervia-h__nav a:hover, #shopify-section-{{ section.id }} .cervia-h__nav a[aria-current="page"] { color: {{ section.settings.color_contador }} !important; border-bottom-color: {{ section.settings.color_contador }} !important; }
  #shopify-section-{{ section.id }} .cervia-h__nav a:focus-visible { outline: 2px solid var(--c-icono) !important; outline-offset: 2px !important; }
  #shopify-section-{{ section.id }} .cervia-h__nav--movil { display: none !important; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cervia-h__izq .cervia-h__nav { display: none !important; }
    #shopify-section-{{ section.id }} .cervia-h__nav--movil { display: flex !important; justify-content: center !important; gap: 22px !important; padding: 8px 16px 0 !important; margin-top: 6px !important; border-top: 1px solid {{ section.settings.color_borde }} !important; }
    #shopify-section-{{ section.id }} .cervia-h__nav--movil a { font-size: 14px !important; }
  }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ section.id }} .cervia-h * { transition-duration: .01ms !important; } }
{%- endstyle -%}
{%- liquid
  case section.settings.destino_logo
    when 'inicio'
      assign logo_href = routes.root_url
    when 'pagina'
      assign logo_href = request.path
    when 'url'
      assign logo_href = section.settings.logo_url
    else
      assign logo_href = ''
  endcase
  assign menu_ok = false
  if section.settings.mostrar_menu and section.settings.menu != blank and linklists[section.settings.menu].links.size > 0
    assign menu_ok = true
  endif
-%}
<div class="cervia-h">
  {%- if section.settings.mostrar_anuncio and section.settings.anuncio != blank -%}
    <div class="cervia-h__anuncio"><p>{{ section.settings.anuncio }}</p></div>
  {%- endif -%}
  <header class="cervia-h__barra">
    <div class="cervia-h__fila{% if section.settings.posicion_logo == 'izquierda' %} is-logo-izquierda{% endif %}">
      {%- if section.settings.posicion_logo == 'izquierda' -%}<{% if logo_href != blank %}a href="{{ logo_href }}"{% else %}div{% endif %} class="cervia-h__logo">
        {%- if section.settings.logo != blank -%}
          {%- assign ancho_logo = section.settings.alto_logo | times: 6 -%}
          {{ section.settings.logo | image_url: width: 600 | image_tag: alt: section.settings.logo_texto, loading: 'eager', width: ancho_logo, height: section.settings.alto_logo }}
        {%- else -%}
          <span class="cervia-h__logo-texto">{{ section.settings.logo_texto }}</span>
        {%- endif -%}
      </{% if logo_href != blank %}a{% else %}div{% endif %}>{%- endif -%}
      <div class="cervia-h__izq">
        {%- if menu_ok and section.settings.estilo_menu == 'enlaces' -%}
          <ul class="cervia-h__nav" role="list">
            {%- for link in linklists[section.settings.menu].links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- elsif menu_ok -%}
          <button type="button" class="cervia-h__btn" data-abrir-menu aria-controls="CerviaMenu-{{ section.id }}" aria-expanded="false" aria-label="{{ section.settings.titulo_menu | escape }}"><svg class="cervia-h-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
        {%- endif -%}
      </div>
      {%- if section.settings.posicion_logo != 'izquierda' -%}<{% if logo_href != blank %}a href="{{ logo_href }}"{% else %}div{% endif %} class="cervia-h__logo">
        {%- if section.settings.logo != blank -%}
          {%- assign ancho_logo = section.settings.alto_logo | times: 6 -%}
          {{ section.settings.logo | image_url: width: 600 | image_tag: alt: section.settings.logo_texto, loading: 'eager', width: ancho_logo, height: section.settings.alto_logo }}
        {%- else -%}
          <span class="cervia-h__logo-texto">{{ section.settings.logo_texto }}</span>
        {%- endif -%}
      </{% if logo_href != blank %}a{% else %}div{% endif %}>{%- endif -%}
      <div class="cervia-h__der">
        {%- if section.settings.mostrar_carrito -%}
          <a href="{{ routes.cart_url }}" class="cervia-h__btn" data-carrito aria-label="{{ section.settings.texto_carrito | escape }}">
            {%- if section.settings.icono_carrito == 'carrito' -%}<svg class="cervia-h-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 4h2.5l2 11h10l2-8H6.5"/><circle cx="9.5" cy="19" r="1.4"/><circle cx="16.5" cy="19" r="1.4"/></svg>{%- else -%}<svg class="cervia-h-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>{%- endif -%}
            {%- if section.settings.mostrar_contador -%}<span class="cervia-h__contador" data-contador{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>{%- endif -%}
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- if menu_ok and section.settings.estilo_menu == 'enlaces' -%}
      <ul class="cervia-h__nav cervia-h__nav--movil" role="list">
        {%- for link in linklists[section.settings.menu].links -%}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </header>
  {%- if menu_ok and section.settings.estilo_menu != 'enlaces' -%}
    <div class="cervia-h__menu" id="CerviaMenu-{{ section.id }}" aria-hidden="true">
      <button type="button" class="cervia-h__velo" data-cerrar-menu tabindex="-1" aria-label="{{ section.settings.texto_cerrar | escape }}"></button>
      <nav class="cervia-h__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.titulo_menu | escape }}">
        <div class="cervia-h__panel-cab">
          <span>{{ section.settings.titulo_menu }}</span>
          <button type="button" class="cervia-h__btn" data-cerrar-menu aria-label="{{ section.settings.texto_cerrar | escape }}"><svg class="cervia-h-i" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
        </div>
        <ul role="list">
          {%- for link in linklists[section.settings.menu].links -%}
            <li><a class="cervia-h__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    </div>
  {%- endif -%}
</div>
<script>
  (() => {
    const raiz = document.querySelector('#shopify-section-{{ section.id }} .cervia-h');
    if (!raiz) return;
    const menu = raiz.querySelector('.cervia-h__menu');
    const abrir = raiz.querySelector('[data-abrir-menu]');
    if (menu && abrir) {
      const cerrar = () => { menu.classList.remove('is-abierto'); menu.setAttribute('aria-hidden', 'true'); abrir.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; abrir.focus(); };
      abrir.addEventListener('click', () => {
        menu.classList.add('is-abierto'); menu.setAttribute('aria-hidden', 'false'); abrir.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden';
        setTimeout(() => menu.querySelector('.cervia-h__link, [data-cerrar-menu]:not(.cervia-h__velo)')?.focus(), 50);
      });
      menu.querySelectorAll('[data-cerrar-menu]').forEach((b) => b.addEventListener('click', cerrar));
      menu.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { cerrar(); return; }
        if (e.key !== 'Tab') return;
        const f = [...menu.querySelectorAll('.cervia-h__panel a, .cervia-h__panel button')];
        if (!f.length) return;
        if (e.shiftKey && document.activeElement === f[0]) { e.preventDefault(); f[f.length - 1].focus(); }
        else if (!e.shiftKey && document.activeElement === f[f.length - 1]) { e.preventDefault(); f[0].focus(); }
      });
    }
    const carrito = raiz.querySelector('[data-carrito]');
    carrito?.addEventListener('click', (e) => {
      const drawer = document.querySelector('cart-drawer');
      if (!drawer || typeof drawer.open !== 'function') return;
      e.preventDefault();
      drawer.open(carrito);
    });
    const contador = raiz.querySelector('[data-contador]');
    if (contador && typeof subscribe === 'function') {
      const actualizar = () => fetch(`${routes.cart_url}.js`, { headers: { Accept: 'application/json' } }).then((r) => r.json()).then((c) => { contador.textContent = c.item_count; contador.hidden = c.item_count === 0; }).catch(() => {});
      subscribe(PUB_SUB_EVENTS.cartUpdate, actualizar);
      document.addEventListener('cart:updated', actualizar);
    }
  })();
</script>
{% schema %}
{
  "name": "Cervia Header",
  "tag": "section",
  "class": "section",
  "settings": [
