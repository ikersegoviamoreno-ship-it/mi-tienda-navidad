{%- comment -%}
  Cervia Vivo: rejilla de productos limpia con tarjetas, valoración y botón de añadir.
{%- endcomment -%}
{%- style -%}
  #shopify-section-{{ section.id }} .cv-pr { background: {{ section.settings.color_fondo }}; color: {{ section.settings.color_texto }}; padding: {{ section.settings.padding }}px 16px; font-family: var(--font-body, var(--font-body-family)); }
  #shopify-section-{{ section.id }} .cv-pr__caja { max-width: {{ section.settings.ancho }}px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .cv-pr__cab { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  #shopify-section-{{ section.id }} .cv-pr__eyebrow { margin: 0 0 8px; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: {{ section.settings.color_acento_2 }}; }
  #shopify-section-{{ section.id }} .cv-pr__titulo { margin: 0; font-family: var(--font-heading, var(--font-heading-family)); font-size: clamp(28px, 3.4vw, 42px); line-height: 1.08; font-weight: 800; letter-spacing: -.02em; color: {{ section.settings.color_texto }}; }
  #shopify-section-{{ section.id }} .cv-pr__titulo span { color: {{ section.settings.color_acento }}; }
  #shopify-section-{{ section.id }} .cv-pr__ver { flex-shrink: 0; font-size: 15px; font-weight: 700; color: {{ section.settings.color_texto }}; text-decoration: none; border-bottom: 2px solid {{ section.settings.color_acento }}; padding-bottom: 2px; }
  #shopify-section-{{ section.id }} .cv-pr__grid { display: grid; grid-template-columns: repeat({{ section.settings.columnas }}, minmax(0, 1fr)); gap: 24px; }
  #shopify-section-{{ section.id }} .cv-pr__card { display: flex; flex-direction: column; background: #FFFFFF; border-radius: 22px; overflow: hidden; box-shadow: 0 1px 0 rgba(11,16,51,.04), 0 10px 30px rgba(11,16,51,.06); transition: transform .25s, box-shadow .25s; }
  #shopify-section-{{ section.id }} .cv-pr__card:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(11,16,51,.12); }
  #shopify-section-{{ section.id }} .cv-pr__media { position: relative; display: block; aspect-ratio: 1 / 1; background: {{ section.settings.color_media }}; overflow: hidden; }
  #shopify-section-{{ section.id }} .cv-pr__media img, #shopify-section-{{ section.id }} .cv-pr__media svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .35s, transform .5s; }
  #shopify-section-{{ section.id }} .cv-pr__img2 { opacity: 0; }
  #shopify-section-{{ section.id }} .cv-pr__card:hover .cv-pr__img2 { opacity: 1; }
  #shopify-section-{{ section.id }} .cv-pr__card:hover .cv-pr__img1 { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .cv-pr__badges { position: absolute; top: 14px; left: 14px; display: flex; flex-direction: column; gap: 6px; z-index: 1; }
  #shopify-section-{{ section.id }} .cv-pr__badge { padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 800; letter-spacing: .03em; color: #FFFFFF; }
  #shopify-section-{{ section.id }} .cv-pr__badge--dto { background: {{ section.settings.color_acento }}; }
  #shopify-section-{{ section.id }} .cv-pr__badge--extra { background: {{ section.settings.color_acento_2 }}; }
  #shopify-section-{{ section.id }} .cv-pr__info { display: flex; flex-direction: column; flex: 1; padding: 18px 20px 20px; }
  #shopify-section-{{ section.id }} .cv-pr__estrellas { display: flex; align-items: center; gap: 6px; font-size: 13px; color: {{ section.settings.color_suave }}; }
  #shopify-section-{{ section.id }} .cv-pr__estrellas b { color: #FFB400; font-size: 15px; letter-spacing: 1px; }
  #shopify-section-{{ section.id }} .cv-pr__nombre { margin: 8px 0 0; font-size: 18px; line-height: 1.3; font-weight: 700; }
  #shopify-section-{{ section.id }} .cv-pr__nombre a { color: inherit; text-decoration: none; }
  #shopify-section-{{ section.id }} .cv-pr__sub { margin: 6px 0 0; font-size: 14px; line-height: 1.5; color: {{ section.settings.color_suave }}; }
  #shopify-section-{{ section.id }} .cv-pr__precio { display: flex; align-items: baseline; gap: 10px; margin-top: auto; padding-top: 14px; }
  #shopify-section-{{ section.id }} .cv-pr__ahora { font-size: 22px; font-weight: 800; color: {{ section.settings.color_texto }}; }
  #shopify-section-{{ section.id }} .cv-pr__antes { font-size: 15px; color: {{ section.settings.color_suave }}; text-decoration: line-through; }
  #shopify-section-{{ section.id }} .cv-pr__form { margin: 14px 0 0; }
  #shopify-section-{{ section.id }} .cv-pr__btn { width: 100%; min-height: 50px; border: 0; border-radius: 999px; background: {{ section.settings.color_boton }}; color: #FFFFFF; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; transition: background .2s, transform .2s; }
  #shopify-section-{{ section.id }} .cv-pr__btn:hover { background: {{ section.settings.color_acento }}; }
  #shopify-section-{{ section.id }} .cv-pr__btn:focus-visible { outline: 3px solid {{ section.settings.color_acento_2 }}; outline-offset: 2px; }
  #shopify-section-{{ section.id }} .cv-pr__btn[disabled] { opacity: .5; cursor: not-allowed; }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .cv-pr__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cv-pr { padding: {{ section.settings.padding_movil }}px 16px; }
    #shopify-section-{{ section.id }} .cv-pr__cab { flex-direction: column; align-items: flex-start; margin-bottom: 18px; }
    #shopify-section-{{ section.id }} .cv-pr__grid { grid-template-columns: repeat({{ section.settings.columnas_movil }}, minmax(0, 1fr)); gap: 12px; }
    #shopify-section-{{ section.id }} .cv-pr__card { border-radius: 16px; }
    #shopify-section-{{ section.id }} .cv-pr__info { padding: 12px 12px 14px; }
    #shopify-section-{{ section.id }} .cv-pr__nombre { font-size: 15px; }
    #shopify-section-{{ section.id }} .cv-pr__sub { display: none; }
    #shopify-section-{{ section.id }} .cv-pr__ahora { font-size: 18px; }
    #shopify-section-{{ section.id }} .cv-pr__antes { font-size: 13px; }
    #shopify-section-{{ section.id }} .cv-pr__btn { min-height: 44px; font-size: 14px; }
    #shopify-section-{{ section.id }} .cv-pr__badges { top: 10px; left: 10px; }
    #shopify-section-{{ section.id }} .cv-pr__badge { font-size: 11px; padding: 5px 9px; }
  }
{%- endstyle -%}

<section class="cv-pr">
  <div class="cv-pr__caja">
    <div class="cv-pr__cab">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="cv-pr__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.titulo != blank -%}<h2 class="cv-pr__titulo">{{ section.settings.titulo }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.ver_todo != blank -%}<a class="cv-pr__ver" href="{{ routes.all_products_collection_url }}">{{ section.settings.ver_todo }}</a>{%- endif -%}
    </div>

    <div class="cv-pr__grid">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.producto -%}
        <article class="cv-pr__card" {{ block.shopify_attributes }}>
          {%- if p != blank -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            <a class="cv-pr__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              <span class="cv-pr__badges">
                {%- if v.compare_at_price > v.price -%}
                  {%- assign dto = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price -%}
                  <span class="cv-pr__badge cv-pr__badge--dto">−{{ dto }} %</span>
                {%- endif -%}
                {%- if block.settings.badge != blank -%}<span class="cv-pr__badge cv-pr__badge--extra">{{ block.settings.badge }}</span>{%- endif -%}
              </span>
              {%- assign img1 = block.settings.imagen | default: p.featured_media -%}
              {%- if img1 != blank -%}
                {{ img1 | image_url: width: 900 | image_tag: class: 'cv-pr__img1', loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', widths: '300, 500, 700, 900', alt: p.title }}
              {%- endif -%}
              {%- assign img2 = block.settings.imagen_hover | default: p.media[1] -%}
              {%- if img2 != blank -%}
                {{ img2 | image_url: width: 900 | image_tag: class: 'cv-pr__img2', loading: 'lazy', sizes: '(min-width: 990px) 33vw, 50vw', widths: '300, 500, 700, 900', alt: '' }}
              {%- endif -%}
            </a>
            <div class="cv-pr__info">
              {%- if block.settings.nota != blank -%}
                <div class="cv-pr__estrellas"><b aria-hidden="true">★★★★★</b><span>{{ block.settings.nota }}{% if block.settings.resenas != blank %} · {{ block.settings.resenas }}{% endif %}</span></div>
              {%- endif -%}
              <h3 class="cv-pr__nombre"><a href="{{ p.url }}">{{ block.settings.nombre | default: p.title }}</a></h3>
              {%- if block.settings.sub != blank -%}<p class="cv-pr__sub">{{ block.settings.sub }}</p>{%- endif -%}
              <div class="cv-pr__precio">
                <span class="cv-pr__ahora">{{ v.price | money }}</span>
                {%- if v.compare_at_price > v.price -%}<span class="cv-pr__antes"><span class="visually-hidden">Antes </span>{{ v.compare_at_price | money }}</span>{%- endif -%}
              </div>
              {%- form 'product', p, class: 'cv-pr__form' -%}
                <input type="hidden" name="id" value="{{ v.id }}">
                <button type="submit" class="cv-pr__btn"{% unless v.available %} disabled{% endunless %}>
                  {%- if v.available -%}{{ section.settings.texto_boton }}{%- else -%}Agotado{%- endif -%}
                </button>
              {%- endform -%}
            </div>
          {%- else -%}
            <div class="cv-pr__media">{{ 'product-1' | placeholder_svg_tag }}</div>
            <div class="cv-pr__info"><h3 class="cv-pr__nombre">Elige un producto</h3></div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cervia Vivo · Productos",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Frase superior", "default": "Lo más vendido" },
    { "type": "inline_richtext", "id": "titulo", "label": "Título", "default": "Nuestros <span>favoritos</span>" },
    { "type": "text", "id": "ver_todo", "label": "Enlace «ver todo»", "default": "Ver todo" },
    { "type": "text", "id": "texto_boton", "label": "Texto del botón", "default": "Añadir al carrito" },
    { "type": "select", "id": "columnas", "label": "Columnas en escritorio", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "select", "id": "columnas_movil", "label": "Columnas en móvil", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "ancho", "label": "Ancho máximo", "min": 700, "max": 1400, "step": 20, "unit": "px", "default": 1240 },
    { "type": "color", "id": "color_fondo", "label": "Fondo", "default": "#F4F6FF" },
    { "type": "color", "id": "color_media", "label": "Fondo de las fotos", "default": "#FFFFFF" },
    { "type": "color", "id": "color_texto", "label": "Texto", "default": "#0B1033" },
    { "type": "color", "id": "color_suave", "label": "Texto suave", "default": "#5A6080" },
    { "type": "color", "id": "color_acento", "label": "Acento principal", "default": "#FF4A1C" },
    { "type": "color", "id": "color_acento_2", "label": "Acento secundario", "default": "#2D5BFF" },
    { "type": "color", "id": "color_boton", "label": "Botón", "default": "#0B1033" },
    { "type": "range", "id": "padding", "label": "Espacio arriba y abajo", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_movil", "label": "Espacio arriba y abajo (móvil)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "producto",
      "name": "Producto",
      "settings": [
        { "type": "product", "id": "producto", "label": "Producto" },
        { "type": "text", "id": "nombre", "label": "Nombre a mostrar", "info": "Vacío = nombre del producto" },
        { "type": "text", "id": "sub", "label": "Frase corta" },
        { "type": "text", "id": "badge", "label": "Etiqueta", "default": "Más vendido" },
        { "type": "text", "id": "nota", "label": "Valoración", "default": "4,8" },
        { "type": "text", "id": "resenas", "label": "Texto junto a la valoración" },
        { "type": "image_picker", "id": "imagen", "label": "Foto principal (opcional)" },
        { "type": "image_picker", "id": "imagen_hover", "label": "Foto al pasar el ratón (opcional)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Cervia Vivo · Productos", "blocks": [{ "type": "producto" }, { "type": "producto" }] }]
}
{% endschema %}
