# Dominio de la tienda Shopify (sin https://)
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
# Token PUBLICO de la Storefront API (Shopify Admin > Apps > Headless / Storefront API)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Versión de la Storefront API
SHOPIFY_API_VERSION=2024-10
# (Opcional) Handle del producto estrella en Shopify. Por defecto: reno-aura
NEXT_PUBLIC_HERO_PRODUCT_HANDLE=reno-aura
# (Opcional) URL pública con dominio propio. En Vercel se detecta sola.
NEXT_PUBLIC_SITE_URL=https://renoaura.com
# Secreto para el webhook de revalidación (/api/revalidate?secret=...)
SHOPIFY_REVALIDATION_SECRET=
# El Admin token NUNCA debe ir en variables NEXT_PUBLIC_* (se expondrían en el navegador).
# Token Admin SOLO para guardar reseñas (se usa únicamente en el servidor, /api/reviews).
# Crea una app personalizada en Shopify con el permiso mínimo `write_metaobjects`.
SHOPIFY_ADMIN_ACCESS_TOKEN=
